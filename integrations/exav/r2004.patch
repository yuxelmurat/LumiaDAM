+    #[test]
+    fn lumiadam_uzak_kopyada_yuksek_bit_uzunluk_degildir() {
+        let prefix: Vec<u8> = (0..32768).map(|i| (i % 251) as u8).collect();
+        for (opcode, count, extra) in [(0x19, 3, None), (0x18, 13, Some(4))] {
+            let mut src = vec![0];
+            let mut length = prefix.len() - 18;
+            while length > 255 {
+                src.push(0);
+                length -= 255;
+            }
+            src.push(length as u8);
+            src.extend_from_slice(&prefix);
+            src.push(opcode);
+            if let Some(n) = extra {
+                src.push(n);
+            }
+            src.extend_from_slice(&[0, 0, 0x11]);
+            let mut want = prefix.clone();
+            want.extend_from_slice(&prefix[..count]);
+            assert_eq!(
+                decompress(&src, want.len()).unwrap(),
+                want,
+                "opcode {opcode:#x}"
+            );
+            assert_eq!(decompress(&src, want.len() - 1), Err(Inflate::TooLong));
+        }
+    }
+}
