{
  "name": "lumiadam",
  "private": true,
  "version": "0.1.0",
  "description": "LumiaDAM — 3D, mimarlık ve tasarım dosyaları için yerel dijital varlık yöneticisi",
  "scripts": {
    "dev": "pnpm --filter @lumiadam/desktop dev",
    "build": "pnpm --filter @lumiadam/desktop build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.21",
      "brace-expansion@5": "5.0.12",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1",
      "source-map-js": "1.2.2"
    }
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "eslint": "^9.13.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuxelmurat/LumiaDAM.git"
  },
  "homepage": "https://github.com/yuxelmurat/LumiaDAM#readme"
}
